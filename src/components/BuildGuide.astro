---
import { acts, getEquipmentId } from "../data/equipment";

const levels = [
  { classLevel: "Monk 1", choice: "Martial Arts, Flurry of Blows" },
  { classLevel: "Monk 2", choice: "Patient Defence, Step of the Wind" },
  { classLevel: "Monk 3", choice: "Choose ", emphasis: "Way of Shadow" },
  { classLevel: "Monk 4", emphasis: "Feat: +2 DEX" },
  { classLevel: "Monk 5", choice: "Extra Attack, Stunning Strike" },
  { classLevel: "Monk 6", choice: "Shadow Step" },
  { classLevel: "Monk 7", choice: "Evasion, Stillness of Mind" },
  { classLevel: "Rogue 1", choice: "Sneak Attack, Expertise" },
  { classLevel: "Rogue 2", choice: "Cunning Actions" },
  { classLevel: "Rogue 3", choice: "Choose ", emphasis: "Assassin" },
  { classLevel: "Rogue 4", emphasis: "Feat: Savage Attacker" },
  { classLevel: "Rogue 5", choice: "Uncanny Dodge, Sneak Attack 3d6" },
];

const abilities = [
  ["STR", 8],
  ["DEX", 17],
  ["CON", 14],
  ["INT", 8],
  ["WIS", 16],
  ["CHA", 10],
];

const equipment = acts.flatMap((act) => act.items);
const loadout = [
  { slot: "Main hand", name: "Bloodthirst" },
  { slot: "Off-hand", name: "Crimson Mischief" },
  { slot: "Ranged", name: "The Dead Shot" },
  { slot: "Head", name: "Mask of Soul Perception" },
  { slot: "Cloak", name: "Shade-Slayer Cloak" },
  { slot: "Body", name: "Vest of Soul Rejuvenation" },
  { slot: "Hands", name: "Bonespike Gloves" },
  { slot: "Feet · Option A", name: "Disintegrating Night Walkers" },
  { slot: "Feet · Option B", name: "Bonespike Boots" },
  { slot: "Amulet", name: "Sentient Amulet (Very Rare)", displayName: "Sentient Amulet" },
  { slot: "Ring", name: "Killer's Sweetheart" },
  { slot: "Ring", name: "Ring of Free Action" },
].map(({ slot, name, displayName }) => {
  const item = equipment.find((candidate) => candidate.name === name);
  if (!item) throw new Error(`Missing level 12 loadout item: ${name}`);

  return { slot, displayName: displayName ?? name, item };
});
---

<section id="build" class="build-guide" tabindex="-1" aria-labelledby="build-title">
  <header class="build-intro">
    <div>
      <p class="section-kicker">Quick build guide</p>
      <h2 id="build-title">Ninja Assassin</h2>
      <p>Follow this while leveling. The final split is Way of Shadow Monk 7 / Assassin Rogue 5.</p>
    </div>
    <a href="https://www.youtube.com/watch?v=6QOYYllhg_w" target="_blank" rel="noreferrer"
      >Source video ↗</a
    >
  </header>

  <div class="build-dashboard">
    <section class="build-card" aria-labelledby="creation-title">
      <p class="build-card__label" id="creation-title">Character creation</p>
      <dl class="fact-list">
        <div><dt>Race</dt><dd>Wood Elf</dd></div>
        <div><dt>Background</dt><dd>Charlatan</dd></div>
        <div><dt>Start</dt><dd>Monk</dd></div>
      </dl>
      <div class="ability-grid" aria-label="Starting ability scores">
        {abilities.map(([name, value]) => (
          <div class:list={{ "is-primary": name === "DEX" }}><span>{name}</span><strong>{value}</strong></div>
        ))}
      </div>
      <p class="build-note"><strong>Bonuses:</strong> +2 DEX, +1 WIS. Use Auntie Ethel's Hair for +1 DEX.</p>
      <p class="build-note"><strong>Skills:</strong> Insight. Later, take Expertise in Stealth and Sleight of Hand.</p>
    </section>

    <section class="build-card" aria-labelledby="combat-title">
      <p class="build-card__label" id="combat-title">Combat loop</p>
      <ol class="combat-list">
        <li>Start fights from stealth to trigger Surprise.</li>
        <li>Shadow Step for Advantage, then use Sneak Attack.</li>
        <li>Use Stunning Strike on threats. Hide or teleport out.</li>
      </ol>
    </section>
  </div>

  <section class="loadout" aria-labelledby="loadout-title">
    <header class="loadout__heading">
      <div>
        <p class="section-kicker">Endgame equipment</p>
        <h3 id="loadout-title">Level 12 loadout</h3>
      </div>
      <p>Select an item to jump to where and how to get it.</p>
    </header>
    <ul class="loadout-grid">
      {loadout.map(({ slot, displayName, item }) => (
        <li>
          <a class="loadout-item" href={`#${getEquipmentId(item.name)}`}>
            <span class="loadout-item__art">
              <img src={`/${item.image}`} alt="" width="72" height="72" loading="lazy" />
            </span>
            <span class="loadout-item__copy">
              <span class="loadout-item__slot">{slot}</span>
              <strong>{displayName}</strong>
            </span>
            <svg aria-hidden="true" viewBox="0 0 20 20">
              <path d="m7 4 6 6-6 6"></path>
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="level-section" aria-labelledby="levels-title">
    <div class="level-section__heading">
      <div>
        <p class="section-kicker">Level by level</p>
        <h3 id="levels-title">What to pick</h3>
      </div>
      <p>Take Monk through level 7, then switch to Rogue.</p>
    </div>
    <ol class="level-path">
      {levels.map(({ classLevel, choice, emphasis }, index) => (
        <li class:list={{ "level-step--rogue": index >= 7 }}>
          <span>{index + 1}</span>
          <strong>{classLevel}</strong>
          <p>{choice}{emphasis && <b>{emphasis}</b>}</p>
        </li>
      ))}
    </ol>
  </section>
</section>
