---
// @ts-expect-error Astro's Vite build resolves this ESM package; this project has no bundler-mode tsconfig.
import { ExternalLink, Skull } from "@lucide/astro";
import ItemDialog from "../components/ItemDialog.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { acts } from "../data/equipment";

type BuildId = "HW" | "LC" | "AA" | "GT";

interface Allocation {
  build: string;
  short: BuildId;
  items: readonly string[];
}

interface FinalConflict {
  item: string;
  builds: readonly BuildId[];
  recommendationOwner: BuildId;
  recommendation: string;
  reason: string;
  alternatives: readonly {
    owner: BuildId;
    label: string;
    items: readonly string[];
  }[];
}

interface ProgressionConflict {
  item: string;
  builds: readonly BuildId[];
  alternatives: readonly {
    owner: BuildId;
    item?: string;
    text?: string;
  }[];
  note?: string;
}

interface PermanentBuff {
  name: string;
  source: string;
  owners: readonly BuildId[];
  effect: string;
  why: string;
  lostOnDeath?: boolean;
}

interface PermanentBuffAct {
  act: string;
  buffs: readonly PermanentBuff[];
}

const equipmentById = new Map(acts.flatMap((act) => act.items).map((item) => [item.id, item]));
const getItem = (id: string) => {
  const item = equipmentById.get(id);
  if (!item) throw new Error(`Unknown party equipment item: ${id}`);
  return item;
};

const builds = [
  { short: "HW", name: "Hexblade Warlock" },
  { short: "LC", name: "Light Cleric" },
  { short: "AA", name: "Arcane Archer" },
  { short: "GT", name: "Giant Thrower" },
] as const;
const buildNames = new Map<BuildId, string>(builds.map((build) => [build.short, build.name]));
const getBuildName = (build: BuildId) => buildNames.get(build) ?? build;

const finalAllocation: readonly Allocation[] = [
  {
    build: "Hexblade Warlock",
    short: "HW",
    items: ["armour-of-agility", "the-dead-shot"],
  },
  {
    build: "Light Cleric",
    short: "LC",
    items: ["amulet-of-the-devout", "helldusk-boots", "viconia-s-walking-fortress"],
  },
  {
    build: "Arcane Archer",
    short: "AA",
    items: ["ketheric-s-shield", "sharpened-snare-cuirass", "amulet-of-bhaal"],
  },
  {
    build: "Giant Thrower",
    short: "GT",
    items: ["hellrider-longbow", "boots-of-genial-striding"],
  },
] as const;

const finalConflicts: readonly FinalConflict[] = [
  {
    item: "armour-of-agility",
    builds: ["HW", "AA"],
    recommendationOwner: "HW",
    recommendation: "Keep on Hexblade",
    reason: "The melee Hexblade benefits more from its AC and +2 to every saving throw.",
    alternatives: [
      { owner: "HW", label: "Hexblade Warlock", items: ["elegant-studded-leather"] },
      { owner: "AA", label: "Arcane Archer", items: ["sharpened-snare-cuirass", "yuan-ti-scale-mail"] },
    ],
  },
  {
    item: "ketheric-s-shield",
    builds: ["LC", "AA"],
    recommendationOwner: "AA",
    recommendation: "Keep on Arcane Archer",
    reason: "It raises the save DC of Arcane Shots while preserving the archer’s shield slot.",
    alternatives: [
      { owner: "LC", label: "Light Cleric", items: ["viconia-s-walking-fortress"] },
      { owner: "AA", label: "Arcane Archer", items: ["sentinel-shield"] },
      { owner: "HW", label: "Hexblade, while levelling", items: ["shield-of-devotion"] },
    ],
  },
  {
    item: "amulet-of-the-devout",
    builds: ["LC", "AA"],
    recommendationOwner: "LC",
    recommendation: "Keep on Light Cleric",
    reason: "The Cleric uses both the spell save DC and the additional Channel Divinity charge.",
    alternatives: [
      { owner: "LC", label: "Light Cleric", items: ["amulet-of-restoration"] },
      { owner: "AA", label: "Arcane Archer", items: ["amulet-of-bhaal"] },
    ],
  },
  {
    item: "helldusk-boots",
    builds: ["LC", "GT"],
    recommendationOwner: "LC",
    recommendation: "Keep on Light Cleric",
    reason: "The automatic saving throw and mobility help protect Spirit Guardians.",
    alternatives: [
      { owner: "LC", label: "Light Cleric", items: ["boots-of-striding"] },
      { owner: "GT", label: "Giant Thrower", items: ["boots-of-genial-striding"] },
    ],
  },
  {
    item: "hellrider-longbow",
    builds: ["HW", "GT"],
    recommendationOwner: "GT",
    recommendation: "Keep on Giant Thrower",
    reason: "The +3 Initiative helps the Thrower enter Giant's Rage and start throwing before enemies can act.",
    alternatives: [
      { owner: "HW", label: "Hexblade Warlock", items: ["the-dead-shot"] },
      { owner: "GT", label: "Giant Thrower", items: ["darkfire-shortbow"] },
    ],
  },
] as const;

const progressionConflicts: readonly ProgressionConflict[] = [
  {
    item: "adamantine-shield",
    builds: ["HW", "LC"],
    alternatives: [
      { owner: "HW", item: "safeguard-shield" },
      { owner: "LC", item: "glowing-shield" },
    ],
  },
  {
    item: "bow-of-awareness",
    builds: ["HW", "LC", "GT"],
    alternatives: [
      { owner: "HW", item: "hunting-shortbow" },
      { owner: "LC", item: "the-joltshooter" },
      { owner: "GT", item: "darkfire-shortbow" },
    ],
  },
  {
    item: "evasive-shoes",
    builds: ["HW", "LC", "GT"],
    alternatives: [
      { owner: "HW", item: "disintegrating-night-walkers" },
      { owner: "LC", item: "boots-of-striding" },
      { owner: "GT", item: "boots-of-genial-striding" },
    ],
  },
  {
    item: "drakethroat-glaive",
    builds: ["HW", "AA"],
    alternatives: [
      { owner: "HW", text: "Cast its own Elemental Weapon, learned at level 6" },
      { owner: "AA", text: "Use the thunder buff for Reverberation" },
    ],
    note: "Prioritise the Arcane Archer: the Hexblade has a built-in substitute, while the Archer relies on thunder damage for its Reverberation setup.",
  },
  {
    item: "surgeon-s-subjugation-amulet",
    builds: ["LC", "GT"],
    alternatives: [
      { owner: "LC", item: "amulet-of-restoration" },
      { owner: "GT", item: "amulet-of-misty-step" },
    ],
  },
  {
    item: "cloak-of-protection",
    builds: ["HW", "GT"],
    alternatives: [
      { owner: "HW", item: "cloak-of-displacement" },
      { owner: "GT", item: "cloak-of-cunning-brume" },
    ],
  },
];

const permanentBuffs: readonly PermanentBuffAct[] = [
  {
    act: "Act I",
    buffs: [
      {
        name: "Auntie Ethel's Hair",
        source: "https://bg3.wiki/wiki/Permanent_bonuses#Auntie_Ethel's_Hair",
        owners: ["GT"],
        effect: "+1 Strength, including above 20.",
        why: "It completes the Thrower's odd starting Strength and helps it reach 24 after its ASI, Everlasting Vigour, and the Mirror of Loss.",
      },
      {
        name: "Volo's Ersatz Eye",
        source: "https://bg3.wiki/wiki/Permanent_bonuses#Volo's_Ersatz_Eye",
        owners: ["LC"],
        effect: "Permanent See Invisibility within 9 m.",
        why: "The Cleric's high Perception and frontline position give it the best chance to reveal nearby invisible enemies.",
      },
      {
        name: "Awakened",
        source: "https://bg3.wiki/wiki/Permanent_bonuses#Awakened",
        owners: ["AA"],
        effect: "Illithid powers cost a bonus action after passing all three Zaith'isk saves.",
        why: "The Archer can group enemies with Black Hole, then use its action and extra attacks against the clustered targets.",
      },
      {
        name: "Loviatar's Love",
        source: "https://bg3.wiki/wiki/Permanent_bonuses#Loviatar's_Love",
        owners: ["HW"],
        effect: "+2 to attack rolls and Wisdom saves below 30% health. Lost on death.",
        why: "The melee Hexblade is the party member most likely to reach the health threshold and benefits directly from the extra accuracy.",
        lostOnDeath: true,
      },
      {
        name: "Necromancy of Thay",
        source: "https://bg3.wiki/wiki/Permanent_bonuses#Necromancy_of_Thay",
        owners: ["LC"],
        effect: "+1 to Wisdom saves and checks, Speak with Dead, and access to Danse Macabre in Act III.",
        why: "The Cleric has the party's best Wisdom saves for finishing the book and can add its ghouls to an already support-focused turn.",
      },
      {
        name: "Survival Instinct",
        source: "https://bg3.wiki/wiki/Permanent_bonuses#Survival_Instinct",
        owners: ["AA"],
        effect: "A once-per-short-rest safeguard that heals a creature when it drops to 0 HP.",
        why: "Awakened lets the Archer apply it as a bonus action without giving up its attacks.",
      },
      {
        name: "BOOOAL's Benediction",
        source: "https://bg3.wiki/wiki/Permanent_bonuses#BOOOAL's_Benediction",
        owners: ["HW", "LC", "AA", "GT"],
        effect: "Advantage against Bleeding targets for every present party member. Keep the kuo-toa alive to retain it.",
        why: "All four characters can receive it, and the Archer's Amulet of Bhaal supplies Bleeding for the whole party to exploit.",
      },
    ],
  },
  {
    act: "Act II",
    buffs: [
      {
        name: "Potion of Everlasting Vigour",
        source: "https://bg3.wiki/wiki/Permanent_bonuses#Potion_of_Everlasting_Vigour",
        owners: ["GT"],
        effect: "+2 Strength, including above 20. It remains after death and respeccing.",
        why: "Strength increases both the Thrower's accuracy and damage through Tavern Brawler, making this the party's highest-value recipient.",
      },
      {
        name: "Githzerai Mind Barrier",
        source: "https://bg3.wiki/wiki/Permanent_bonuses#Githzerai_Mind_Barrier",
        owners: ["GT"],
        effect: "Advantage on Intelligence saves. Lost on death.",
        why: "The Thrower starts with 8 Intelligence and otherwise has little protection against Intelligence-based control.",
        lostOnDeath: true,
      },
      {
        name: "Arabella's Shadow Entangle",
        source: "https://bg3.wiki/wiki/Permanent_bonuses#Arabella's_Shadow_Entangle",
        owners: ["LC"],
        effect: "Restrains one Undead or Shadow creature once per short rest.",
        why: "The Cleric can hold a target inside Spirit Guardians while the rest of the party attacks it with advantage.",
      },
    ],
  },
  {
    act: "Act III",
    buffs: [
      {
        name: "Mirror of Loss",
        source: "https://bg3.wiki/wiki/Permanent_bonuses#Mirror_of_Loss",
        owners: ["HW", "LC", "AA", "GT"],
        effect: "Each character can gain +2 to one ability, up to 24, and may also obtain the optional +1 Charisma memory.",
        why: "It is not a shared resource. Give HW Charisma, LC Wisdom, AA Dexterity, and GT Strength; seek the extra Charisma memory for HW.",
      },
      {
        name: "Sweet Stone Features",
        source: "https://bg3.wiki/wiki/Permanent_bonuses#Sweet_Stone_Features",
        owners: ["AA"],
        effect: "+1d4 to attack rolls and saving throws after each long rest. Only one party member can have the statue.",
        why: "The accuracy offsets Sharpshooter on every one of the Archer's three attacks, including Arrow of Many Targets attack rolls.",
      },
      {
        name: "The Tharchiate Codex: Blessing",
        source: "https://bg3.wiki/wiki/Permanent_bonuses#The_Tharchiate_Codex:_Blessing",
        owners: ["LC"],
        effect: "20 temporary HP after each long rest and the key to finishing the Necromancy of Thay.",
        why: "The Cleric already holds the Necromancy of Thay, so the same character must read the Codex to unlock Danse Macabre.",
      },
      {
        name: "Anointed in Splendour",
        source: "https://bg3.wiki/wiki/Permanent_bonuses#Anointed_in_Splendour",
        owners: ["HW", "LC", "AA", "GT"],
        effect: "+2 to every saving throw. Each character can make a separate offering at Stormshore Tabernacle.",
        why: "The reward is available separately to every character, so there is no reason to choose only one recipient if the party can afford it.",
      },
      {
        name: "Partial Ceremorphosis",
        source: "https://bg3.wiki/wiki/Permanent_bonuses#Partial_Ceremorphosis",
        owners: ["HW", "LC", "AA", "GT"],
        effect: "Unlocks Fly, all tier-one illithid powers, and access to tier-three powers, with permanent cosmetic consequences.",
        why: "Fly improves positioning for every build. Give it to every willing character because the Astral-Touched Tadpole can be shared.",
      },
    ],
  },
];
---

<SiteLayout
  title="Party equipment plan | The Wayfarer's Ledger"
  description="A conflict-free equipment plan for the Hexblade Warlock, Light Cleric, Arcane Archer, and Giant Thrower."
  noindex
>
  <article class="party-plan">
    <header class="party-hero">
      <div class="party-hero__copy">
        <p class="eyebrow">Four builds · one loot pool</p>
        <h1>Who gets what?</h1>
        <p class="party-hero__lede">
          A practical equipment split for our Hexblade Warlock, Light Cleric, Arcane Archer, and Giant Thrower.
          Start with the final allocation; use the fallback list when two characters want the same item while levelling.
        </p>
      </div>
      <div class="party-roster" aria-label="Build abbreviations">
        {builds.map((build) => (
          <div class="party-roster__member" data-build={build.short}>
            <abbr title={build.name}>{build.short}</abbr>
            <strong>{build.name}</strong>
          </div>
        ))}
      </div>
    </header>

    <section class="allocation" aria-labelledby="allocation-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Use this split</p>
          <h2 id="allocation-title">Conflict-free final allocation</h2>
        </div>
        <p>Recommended</p>
      </div>

      <div class="allocation-grid">
        {finalAllocation.map((entry) => (
          <section class="allocation-card" data-build={entry.short}>
            <header>
              <abbr title={entry.build}>{entry.short}</abbr>
              <h3>{entry.build}</h3>
            </header>
            <ul>
              {entry.items.map((id) => {
                const item = getItem(id);
                return (
                  <li>
                    <button
                      class="item-reference"
                      type="button"
                      data-item-reference
                      data-name={item.name}
                      data-meta={`${item.rarity} · ${item.type}`}
                      data-description={item.effects}
                      data-image={item.image}
                      data-source={item.source}
                    >
                      {item.image && <img src={item.image} alt="" width="36" height="36" loading="lazy" />}
                      <span>{item.name}</span>
                    </button>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>
      <p class="allocation-note">
        Everything not listed here stays as written in the original builds. These are only the contested final slots.
      </p>
    </section>

    <section class="permanent-bonuses" aria-labelledby="permanent-bonuses-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">One chance per campaign</p>
          <h2 id="permanent-bonuses-title">Permanent bonus plan</h2>
        </div>
        <p>Recommended recipients</p>
      </div>
      <p class="permanent-bonuses__intro">
        Assign character-bound rewards before starting their scenes. Bonuses shown for all four characters can be
        earned by everyone, provided each character meets the requirement.
      </p>

      <div class="buff-filter" role="group" aria-label="Filter permanent bonuses by party member">
        <span>Show bonuses for</span>
        <div class="buff-filter__controls">
          <button class="is-active" type="button" data-buff-filter="all" aria-pressed="true">All party</button>
          {builds.map((build) => (
            <button type="button" data-buff-filter={build.short} aria-pressed="false">
              <abbr title={build.name} data-build={build.short}>{build.short}</abbr>
              <span>{build.name}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="buff-act-grid">
        {permanentBuffs.map((group) => (
          <section class="buff-act">
            <header>
              <p>{group.act}</p>
              <span data-buff-count>{group.buffs.length} bonuses</span>
            </header>
            <ol>
              {group.buffs.map((buff) => (
                <li data-buff-owners={buff.owners.join(" ")}>
                  <div class="buff-card__heading">
                    <a href={buff.source} target="_blank" rel="noreferrer">
                      {buff.name} <ExternalLink class="external-link-icon" aria-hidden="true" size={13} stroke-width={1.7} />
                    </a>
                    <div class="buff-card__meta">
                      {buff.lostOnDeath && (
                        <span class="death-warning" title="Lost on death" aria-label="Lost on death">
                          <Skull aria-hidden="true" size={14} stroke-width={1.7} />
                          <span class="sr-only">Lost on death</span>
                        </span>
                      )}
                      <p class="build-owners" aria-label={`Recommended for ${buff.owners.map(getBuildName).join(", ")}`}>
                        {buff.owners.map((owner) => <abbr title={getBuildName(owner)} data-build={owner}>{owner}</abbr>)}
                      </p>
                    </div>
                  </div>
                  <p>{buff.effect}</p>
                  <p class="buff-card__why"><strong>Why:</strong> {buff.why}</p>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    </section>

    <section class="conflicts" aria-labelledby="final-conflicts-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Five decisions</p>
          <h2 id="final-conflicts-title">Final-loadout conflicts</h2>
        </div>
        <p>Matters at level 12</p>
      </div>

      <div class="conflict-list">
        {finalConflicts.map((conflict, index) => (
          <article class="conflict-card">
            <div class="conflict-card__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
            <div class="conflict-card__decision">
              <p class="build-owners" aria-label="Builds sharing this item">
                {conflict.builds.map((build) => <abbr title={getBuildName(build)} data-build={build}>{build}</abbr>)}
              </p>
              <h3>
                {(() => {
                  const item = getItem(conflict.item);
                  return (
                    <button
                      class="item-reference item-reference--title"
                      type="button"
                      data-item-reference
                      data-name={item.name}
                      data-meta={`${item.rarity} · ${item.type}`}
                      data-description={item.effects}
                      data-image={item.image}
                      data-source={item.source}
                    >
                      {item.image && <img src={item.image} alt="" width="44" height="44" loading="lazy" />}
                      <span>{item.name}</span>
                    </button>
                  );
                })()}
              </h3>
              <strong data-build={conflict.recommendationOwner}>{conflict.recommendation}</strong>
              <p>{conflict.reason}</p>
            </div>
            <div class="conflict-card__fallbacks">
              <p>Fallbacks for either choice</p>
              <dl>
                {conflict.alternatives.map((alternative) => (
                  <div>
                    <dt data-build={alternative.owner}>{alternative.label}</dt>
                    <dd>
                      {alternative.items.map((id, itemIndex) => {
                        const item = getItem(id);
                        return (
                          <>
                            {itemIndex > 0 && <span class="item-separator">or</span>}
                            <button
                              class="item-reference item-reference--compact"
                              type="button"
                              data-item-reference
                              data-name={item.name}
                              data-meta={`${item.rarity} · ${item.type}`}
                              data-description={item.effects}
                              data-image={item.image}
                              data-source={item.source}
                            >
                              {item.image && <img src={item.image} alt="" width="32" height="32" loading="lazy" />}
                              <span>{item.name}</span>
                            </button>
                          </>
                        );
                      })}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="progression" aria-labelledby="progression-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Temporary overlaps</p>
          <h2 id="progression-title">Conflicts while levelling</h2>
        </div>
        <p>{progressionConflicts.length} shared items</p>
      </div>
      <p class="progression__intro">
        These items appear in more than one route, but not in both final loadouts. Pass them between characters when
        someone upgrades, or use the replacements below.
      </p>

      <div class="progression-list">
        {progressionConflicts.map((conflict) => (
          <article class="progression-row">
            <div>
              <p class="build-owners" aria-label="Builds sharing this item">
                {conflict.builds.map((build) => <abbr title={getBuildName(build)} data-build={build}>{build}</abbr>)}
              </p>
              <h3>
                {(() => {
                  const item = getItem(conflict.item);
                  return (
                    <button
                      class="item-reference item-reference--title"
                      type="button"
                      data-item-reference
                      data-name={item.name}
                      data-meta={`${item.rarity} · ${item.type}`}
                      data-description={item.effects}
                      data-image={item.image}
                      data-source={item.source}
                    >
                      {item.image && <img src={item.image} alt="" width="40" height="40" loading="lazy" />}
                      <span>{item.name}</span>
                    </button>
                  );
                })()}
              </h3>
            </div>
            <div class="progression-row__alternatives">
              {conflict.alternatives.map((alternative) => (
                <div class="progression-alternative">
                  <abbr title={getBuildName(alternative.owner)} data-build={alternative.owner}>{alternative.owner}</abbr>
                  {alternative.item ? (() => {
                    const item = getItem(alternative.item);
                    return (
                      <button
                        class="item-reference item-reference--compact"
                        type="button"
                        data-item-reference
                        data-name={item.name}
                        data-meta={`${item.rarity} · ${item.type}`}
                        data-description={item.effects}
                        data-image={item.image}
                        data-source={item.source}
                      >
                        {item.image && <img src={item.image} alt="" width="32" height="32" loading="lazy" />}
                        <span>{item.name}</span>
                      </button>
                    );
                  })() : <span>{alternative.text}</span>}
                </div>
              ))}
              {conflict.note && <small>{conflict.note}</small>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <aside class="legend" aria-label="Build abbreviation key">
      <strong>Build key</strong>
      <p><abbr title="Hexblade Warlock" data-build="HW">HW</abbr> Hexblade Warlock</p>
      <p><abbr title="Light Cleric" data-build="LC">LC</abbr> Light Cleric</p>
      <p><abbr title="Arcane Archer" data-build="AA">AA</abbr> Arcane Archer</p>
      <p><abbr title="Giant Thrower" data-build="GT">GT</abbr> Giant Thrower</p>
    </aside>
  </article>

  <ItemDialog />
</SiteLayout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-buff-filter]");
  const buffCards = document.querySelectorAll<HTMLElement>("[data-buff-owners]");

  const filterBuffs = (owner: string) => {
    filterButtons.forEach((button) => {
      const isSelected = button.dataset.buffFilter === owner;
      button.classList.toggle("is-active", isSelected);
      button.setAttribute("aria-pressed", String(isSelected));
    });

    buffCards.forEach((card) => {
      card.hidden = owner !== "all" && !card.dataset.buffOwners?.split(" ").includes(owner);
    });

    document.querySelectorAll<HTMLElement>(".buff-act").forEach((act) => {
      const visibleBuffs = act.querySelectorAll<HTMLElement>("[data-buff-owners]:not([hidden])").length;
      const count = act.querySelector<HTMLElement>("[data-buff-count]");
      if (count) count.textContent = `${visibleBuffs} ${visibleBuffs === 1 ? "bonus" : "bonuses"}`;
    });
  };

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => filterBuffs(button.dataset.buffFilter ?? "all"));
  });
</script>

<style>
  .party-plan {
    --panel: var(--surface);
    --panel-strong: var(--surface-raised);
