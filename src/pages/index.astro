---
import { builds } from "../builds/build-registry";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="The Wayfarer's Ledger | Baldur's Gate 3 builds"
  description="Practical Baldur's Gate 3 builds with level-by-level choices and equipment checklists."
>
  <section class="index-hero">
    <div class="index-hero__texture" aria-hidden="true"></div>
    <div class="index-hero__inner">
      <p class="eyebrow">A Baldur's Gate III field guide</p>
      <h1>Choose your path.</h1>
      <p>Leveling choices, combat notes, and equipment routes built to stay open beside the game.</p>
    </div>
  </section>

  <aside class="party-plan-link" aria-labelledby="party-plan-link-title">
    <div>
      <p class="section-kicker">Four builds · one loot pool</p>
      <h2 id="party-plan-link-title">Planning a full party?</h2>
      <p>Resolve contested equipment and assign permanent bonuses across the Hexblade, Cleric, Archer, and Thrower.</p>
    </div>
    <a href="/party-equipment/">Open the party equipment plan <span aria-hidden="true">→</span></a>
  </aside>

  <section class="build-index" aria-labelledby="builds-title">
    <header class="build-index__heading">
      <div>
        <p class="section-kicker">The archive</p>
        <h2 id="builds-title">All builds</h2>
      </div>
      <p>{builds.length} {builds.length === 1 ? "build" : "builds"}</p>
    </header>

    <ol class="build-list">
      {builds.map((build, index) => (
        <li>
          <a href={`/builds/${build.id}/`}>
            <span class="build-list__number">{String(index + 1).padStart(2, "0")}</span>
            <span class="build-list__body">
              <span class="build-list__class">{build.class}</span>
              <strong>{build.title}</strong>
              <span class="build-list__description">{build.description}</span>
              <span class="build-list__tags">
                {build.tags.map((tag) => <span>{tag}</span>)}
              </span>
            </span>
            <span class="build-list__split">
              <small>Level 12</small>
              {build.levelSplit}
            </span>
            <svg aria-hidden="true" viewBox="0 0 20 20"><path d="m7 4 6 6-6 6"></path></svg>
          </a>
        </li>
      ))}
    </ol>
  </section>
</SiteLayout>
