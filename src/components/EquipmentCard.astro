---
import type { EquipmentItem } from "../data/equipment";

interface Props {
  act: number;
  item: EquipmentItem;
}

const { act, item }: Props = Astro.props;
const id = item.id;
const searchText =
  `${item.name} ${item.type} ${item.location} ${item.directions} ${item.effects} ${item.attributes}`.toLowerCase();
---

<article id={id} class="item-card" data-act={act} data-route-card data-equipment-card data-search={searchText}>
  <div class="item-card__art">
    {item.image && <img src={item.image} alt="" width="144" height="144" loading="lazy" />}
    <label class="item-card__check" title={`Mark ${item.name} as collected`}>
      <span class="sr-only">Mark {item.name} as collected</span>
      <input type="checkbox" data-item-id={id} />
      <span class="item-card__checkbox">
        <svg aria-hidden="true" viewBox="0 0 20 20"><path d="m4 10.5 3.6 3.6L16 5.8"></path></svg>
      </span>
    </label>
  </div>
  <div class="item-card__body">
    <p class="item-card__meta">
      <span class="rarity-dot" data-rarity={item.rarity}></span>
      {item.rarity} · {item.type}
    </p>
    <h3>{item.name}</h3>
    {item.attributes && <p class="item-card__attributes">{item.attributes}</p>}
    <p class="item-card__location">
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
        <circle cx="12" cy="10" r="2.5"></circle>
      </svg>
      <span>{item.location}</span>
    </p>
    <p class="item-card__directions">{item.directions}</p>
    {item.warning && <p class="item-card__warning">{item.warning}</p>}
    {item.effects && <p class="item-card__effects">{item.effects}</p>}
    <a class="item-card__source" href={item.source} target="_blank" rel="noreferrer">Check source ↗</a>
  </div>
</article>
