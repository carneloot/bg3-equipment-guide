<dialog class="item-dialog" data-item-dialog aria-labelledby="item-dialog-title">
  <button class="item-dialog__close" type="button" data-item-dialog-close aria-label="Close item details">×</button>
  <div class="item-dialog__art"><img data-item-dialog-image src="" alt="" width="128" height="128" /></div>
  <div class="item-dialog__body">
    <p data-item-dialog-meta></p>
    <h2 id="item-dialog-title" data-item-dialog-name></h2>
    <p data-item-dialog-description></p>
    <a data-item-dialog-source href="" target="_blank" rel="noreferrer">Open on BG3 Wiki ↗</a>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-item-dialog]");
  const dialogImage = dialog?.querySelector<HTMLImageElement>("[data-item-dialog-image]");
  const dialogName = dialog?.querySelector<HTMLElement>("[data-item-dialog-name]");
  const dialogMeta = dialog?.querySelector<HTMLElement>("[data-item-dialog-meta]");
  const dialogDescription = dialog?.querySelector<HTMLElement>("[data-item-dialog-description]");
  const dialogSource = dialog?.querySelector<HTMLAnchorElement>("[data-item-dialog-source]");

  document.querySelectorAll<HTMLButtonElement>("[data-item-reference]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!dialog || !dialogImage || !dialogName || !dialogMeta || !dialogDescription || !dialogSource) return;
      dialogImage.src = button.dataset.image ?? "";
      dialogImage.hidden = !button.dataset.image;
      dialogName.textContent = button.dataset.name ?? "";
      dialogMeta.textContent = button.dataset.meta ?? "";
      dialogDescription.textContent = button.dataset.description ?? "";
      dialogSource.href = button.dataset.source ?? "";
      dialog.showModal();
    });
  });

  dialog?.querySelector<HTMLButtonElement>("[data-item-dialog-close]")?.addEventListener("click", () => dialog.close());
  dialog?.addEventListener("click", (event) => {
    const bounds = dialog.getBoundingClientRect();
    const outside =
      event.clientX < bounds.left || event.clientX > bounds.right ||
      event.clientY < bounds.top || event.clientY > bounds.bottom;
    if (outside) dialog.close();
  });
</script>

<style>
  .item-dialog {
    width: min(34rem, calc(100% - 2rem));
    max-height: min(42rem, calc(100dvh - 2rem));
    padding: 0;
    border: 1px solid var(--line-bright);
    background: var(--surface-raised);
    color: var(--ink);
    box-shadow: 0 2px 3px rgb(0 0 0 / 0.28), 0 18px 50px rgb(0 0 0 / 0.45);
  }

  .item-dialog::backdrop {
    background: rgb(8 6 4 / 0.78);
    backdrop-filter: blur(3px);
  }

  .item-dialog__close {
    position: absolute;
    z-index: 1;
    top: 0.6rem;
    right: 0.6rem;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line-bright);
    background: rgb(23 19 15 / 0.88);
    color: var(--ink-bright);
    font: 1.5rem var(--serif-body);
    cursor: pointer;
  }

  .item-dialog__art {
    display: grid;
    place-items: center;
    min-height: 13rem;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(circle, rgb(199 168 104 / 0.13), transparent 55%),
      var(--surface);
  }

  .item-dialog__art img {
    width: 8rem;
    height: 8rem;
    object-fit: contain;
    filter: drop-shadow(0 10px 20px rgb(0 0 0 / 0.35));
  }

  .item-dialog__body {
    padding: 1.5rem;
  }

  .item-dialog__body > p:first-child {
    margin-bottom: 0.35rem;
    color: var(--gold);
    font: 600 0.65rem var(--serif-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .item-dialog h2 {
    margin-bottom: 0.8rem;
    color: var(--ink-bright);
    font: 600 clamp(1.4rem, 4vw, 2rem) / 1.15 var(--serif-display);
  }

  .item-dialog__body > p:nth-of-type(2) {
    max-width: 58ch;
    margin-bottom: 1.25rem;
    color: #c8bdad;
    white-space: pre-line;
  }

  .item-dialog__body > a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--gold-bright);
    font: 600 0.72rem var(--serif-display);
    letter-spacing: 0.04em;
  }

  @media (hover: hover) and (pointer: fine) {
    .item-dialog__close:hover {
      border-color: var(--gold);
      color: var(--gold-bright);
    }
  }

  @media (max-width: 560px) {
    .item-dialog__art {
      min-height: 10rem;
    }

    .item-dialog__art img {
      width: 6rem;
      height: 6rem;
    }
  }
</style>
