---
interface Props {
  totalItems: number;
  description: string;
  source?: string;
  sourceLabel?: string;
}

const { totalItems, description, source, sourceLabel }: Props = Astro.props;
---

<header class="hero">
  <div class="hero__texture" aria-hidden="true"></div>
  <div class="hero__inner">
    <a class="hero__back" href="/">← All builds</a>
    <p class="eyebrow">A Baldur's Gate III field guide</p>
    <h1>The Wayfarer's Ledger</h1>
    <p class="hero__lede">{description}</p>

    <nav class="hero__actions" aria-label="Guide sections">
      <a class="hero__action hero__action--primary" href="#build">Read the build</a>
      <a class="hero__action" href="#equipment">Open equipment route</a>
      {source && <a class="hero__source" href={source} target="_blank" rel="noreferrer">{sourceLabel ?? "Source"} ↗</a>}
    </nav>

    <div class="progress-panel" aria-label="Collection progress">
      <div class="progress-panel__copy">
        <span class="progress-panel__label">Collected</span>
        <strong><span id="collected-count">0</span> / <span id="total-count">{totalItems}</span></strong>
      </div>
      <div
        class="progress-track"
        role="progressbar"
        aria-label="Equipment collected"
        aria-valuemin="0"
        aria-valuemax={totalItems}
        aria-valuenow="0"
      >
        <span id="progress-fill"></span>
      </div>
      <button class="reset-button" id="reset-progress" type="button">Reset checks</button>
    </div>
  </div>
</header>
