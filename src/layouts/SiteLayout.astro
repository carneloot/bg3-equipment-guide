---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  backHref?: string;
  noindex?: boolean;
}

const { title, description, backHref, noindex = false }: Props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#17130f" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&amp;family=Crimson+Pro:ital,wght@0,400;0,500;0,600;1,400&amp;display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="site-mark" href="/">
        <span aria-hidden="true">W</span>
        <span>The Wayfarer's Ledger</span>
      </a>
      {backHref && <a class="back-link" href={backHref}>← All builds</a>}
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>A field guide for Baldur's Gate III.</p>
      <p>Checklist progress stays in this browser.</p>
    </footer>
  </body>
</html>
