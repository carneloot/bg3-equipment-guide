---
import type { BuildDefinition } from "../builds/define-build";
import type { Act } from "../data/equipment";

interface Props {
  build: BuildDefinition;
  acts: readonly Act[];
}

const { build, acts }: Props = Astro.props;
const abilities = Object.entries(build.abilities) as [keyof typeof build.abilities, number][];
const equipment = acts.flatMap((act) => act.items);
const loadout = build.loadout.map(({ slot, item: itemId, displayName }) => {
  const item = equipment.find((candidate) => candidate.id === itemId);
  if (!item) throw new Error(`Missing level 12 loadout item: ${itemId}`);

  return { slot, displayName: displayName ?? item.name, item };
});
---

<section id="build" class="build-guide" tabindex="-1" aria-labelledby="build-title">
  <header class="build-intro">
    <div>
      <p class="section-kicker">Quick build guide</p>
      <h2 id="build-title">{build.title}</h2>
      <p>{build.intro}</p>
    </div>
    {build.source && <a href={build.source} target="_blank" rel="noreferrer">{build.sourceLabel ?? "Source"} ↗</a>}
  </header>

  <div class="build-dashboard">
    <section class="build-card" aria-labelledby="creation-title">
      <p class="build-card__label" id="creation-title">Character creation</p>
      <dl class="fact-list">
        {build.creation.map(({ label, value }) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
      </dl>
      <div class="ability-grid" aria-label="Starting ability scores">
        {abilities.map(([name, value]) => (
          <div class:list={{ "is-primary": name === build.primaryAbility }}><span>{name}</span><strong>{value}</strong></div>
        ))}
      </div>
      {build.creationNotes.map(({ label, text }) => <p class="build-note"><strong>{label}:</strong> {text}</p>)}
    </section>

    <section class="build-card" aria-labelledby="combat-title">
      <p class="build-card__label" id="combat-title">Combat loop</p>
      <ol class="combat-list">
        {build.combat.map((step: string) => <li>{step}</li>)}
      </ol>
    </section>
  </div>

  <section class="loadout" aria-labelledby="loadout-title">
    <header class="loadout__heading">
      <div>
        <p class="section-kicker">Endgame equipment</p>
        <h3 id="loadout-title">Level 12 loadout</h3>
      </div>
      <p>Select an item to jump to where and how to get it.</p>
    </header>
    <ul class="loadout-grid">
      {loadout.map(({ slot, displayName, item }) => (
        <li>
          <a class="loadout-item" href={`#${item.id}`}>
            <span class="loadout-item__art">
              <img src={`/${item.image}`} alt="" width="72" height="72" loading="lazy" />
            </span>
            <span class="loadout-item__copy">
              <span class="loadout-item__slot">{slot}</span>
              <strong>{displayName}</strong>
            </span>
            <svg aria-hidden="true" viewBox="0 0 20 20">
              <path d="m7 4 6 6-6 6"></path>
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="level-section" aria-labelledby="levels-title">
    <div class="level-section__heading">
      <div>
        <p class="section-kicker">Level by level</p>
        <h3 id="levels-title">What to pick</h3>
      </div>
      <p>{build.levelNote}</p>
    </div>
    <ol class="level-path">
      {build.levels.map(({ classLevel, choice, emphasis, secondary }, index: number) => (
        <li class:list={{ "level-step--rogue": secondary }}>
          <span>{index + 1}</span>
          <strong>{classLevel}</strong>
          <p>{choice}{emphasis && <b>{emphasis}</b>}</p>
        </li>
      ))}
    </ol>
  </section>
</section>
