---
import { builds } from "../../builds/build-registry";
import type { BuildDefinition } from "../../builds/define-build";
import BuildGuide from "../../components/BuildGuide.astro";
import EquipmentGuide from "../../components/EquipmentGuide.astro";
import EquipmentToolbar from "../../components/EquipmentToolbar.astro";
import Footer from "../../components/Footer.astro";
import Hero from "../../components/Hero.astro";
import ItemDialog from "../../components/ItemDialog.astro";
import { getActsForEquipment } from "../../data/equipment";
import "../../styles/global.css";

export async function getStaticPaths() {
  return builds.map((build) => ({ params: { id: build.id }, props: { build } }));
}

interface Props {
  build: BuildDefinition;
}

const { build }: Props = Astro.props;
const acts = getActsForEquipment(build.equipment);
const finalLoadoutIds = new Set(build.loadout.map(({ item }) => item));
const totalItems = acts.reduce((total, act) => total + act.items.length, 0);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#17130f" />
    <meta name="description" content={build.description} />
    <title>{build.title} | The Wayfarer's Ledger</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&amp;family=Crimson+Pro:ital,wght@0,400;0,500;0,600;1,400&amp;display=swap"
      rel="stylesheet"
    />
    <script src="../../scripts/checklist.ts"></script>
  </head>
  <body data-build-id={build.id}>
    <a class="skip-link" href="#build">Skip to build guide</a>
    <Hero
      totalItems={totalItems}
      description={build.heroDescription}
      source={build.source}
      sourceLabel={build.sourceLabel}
    />
    <main id="guide-content">
      <BuildGuide build={build} acts={acts} />
      <EquipmentToolbar acts={acts} totalItems={totalItems} />
      <EquipmentGuide acts={acts} finalLoadoutIds={finalLoadoutIds} />
    </main>
    <ItemDialog />
    <Footer />
  </body>
</html>
