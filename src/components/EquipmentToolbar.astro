---
import type { Act } from "../data/equipment";

interface Props {
  acts: readonly Act[];
  totalItems: number;
}

const { acts, totalItems }: Props = Astro.props;
const roman = ["I", "II", "III"];
---

<div class="toolbar-wrap">
  <nav class="act-nav" aria-label="Filter equipment by act">
    <button class="act-nav__button is-active" type="button" data-filter-act="all" aria-pressed="true">
      All <span>{totalItems}</span>
    </button>
    {acts.map((act) => (
      <button class="act-nav__button" type="button" data-filter-act={act.id} aria-pressed="false">
        Act {roman[act.id - 1]} <span>{act.items.length + act.requirements.length}</span>
      </button>
    ))}
  </nav>

  <label class="search">
    <span class="sr-only">Search by item, place, or character</span>
    <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m16.2 16.2 4.3 4.3"></path>
    </svg>
    <input id="search" type="search" placeholder="Search the equipment route" autocomplete="off" />
  </label>
</div>
